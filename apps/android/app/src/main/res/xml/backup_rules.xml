<?xml version="1.0" encoding="utf-8"?>

<full-backup-content>

    <!--
        RIETI - Protección de borradores.

        Evitamos respaldar la base de datos local,
        porque contiene reportes cifrados cuya clave
        se administra mediante Android Keystore.
    -->

    <exclude
        domain="database"
        path="rieti_report_drafts.db" />

    <exclude
        domain="database"
        path="rieti_report_drafts.db-wal" />

    <exclude
        domain="database"
        path="rieti_report_drafts.db-shm" />

</full-backup-content>
