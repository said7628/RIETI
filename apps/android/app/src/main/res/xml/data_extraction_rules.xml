<?xml version="1.0" encoding="utf-8"?>

<data-extraction-rules>

    <!--
        RIETI - Respaldo en la nube.

        Se excluye la base de datos de borradores
        para proteger la información local.
    -->
    <cloud-backup>

        <exclude
            domain="database"
            path="rieti_report_drafts.db" />

        <exclude
            domain="database"
            path="rieti_report_drafts.db-wal" />

        <exclude
            domain="database"
            path="rieti_report_drafts.db-shm" />

    </cloud-backup>

    <!--
        RIETI - Transferencia entre dispositivos.

        Los borradores cifrados no deben transferirse
        sin sus claves de Android Keystore.
    -->
    <device-transfer>

        <exclude
            domain="database"
            path="rieti_report_drafts.db" />

        <exclude
            domain="database"
            path="rieti_report_drafts.db-wal" />

        <exclude
            domain="database"
            path="rieti_report_drafts.db-shm" />

    </device-transfer>

</data-extraction-rules>
